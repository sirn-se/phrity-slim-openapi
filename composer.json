{
    "name": "phrity/slim-openapi",
    "type": "library",
    "description": "OpenApi implementation for Slim 4.",
    "homepage": "https://phrity.sirn.se/slim-openapi",
    "keywords": ["slim", "openapi", "routing", "router"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sören Jensen",
            "email": "sirn@sirn.se",
            "homepage": "https://phrity.sirn.se"
        }
    ],
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "": "tests/classes/"
        }
    },
    "require": {
        "php": "^8.1",
        "cebe/php-openapi": "^1.4",
        "league/openapi-psr7-validator": ">=0.15 <1.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "slim/slim": "^4.0"
    },
    "require-dev": {
        "php-di/php-di": "^6.0 || ^7.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "slim/psr7": "^1.0",
        "robiningelbrecht/phpunit-coverage-tools": "^1.9",
        "squizlabs/php_codesniffer": "^3.5 || ^4.0"
    }
}
